BLOOP_ENV=dev
BLOOP_PORT=:9090
USES_TLS=true
BLOOP_TLS_CERT_PATH={. . .}
BLOOP_TLS_KEY_PATH={. . .}

LOG_LEVEL=debug

COOKIE_HASH_KEY={. . .}
COOKIE_BLOCK_KEY={. . .}

GOOGLE_CLIENT_ID={. . .}
GOOGLE_CLIENT_SECRET={. . .}
GOOGLE_CALLBACK_URL=http://localhost:9090/callback?provider=google

PPROF_ENABLED=true
GUESTS_ENABLED=true
ROOT_DOMAIN="localhost"

# Hub Settings
IS_HUB=true
DOMAINS="http://localhost:9090,https://s0.bloopworld.co"

# Game-server Settings
SERVER_NAME="Borzoi🐶"
DOMAIN_NAME=http://localhost:9090
CORS_PREFIX="http"
AUTO_PLAYER_PASSWORD={. . .}

MONGO_HOST="localhost"
MONGO_PORT=":27017"
MONGO_PREFIX=""
MONGO_USER={. . .}
MONGO_PASS={. . .}